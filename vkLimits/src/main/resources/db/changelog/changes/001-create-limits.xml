<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-user-limits-table" author="system">
        <createTable tableName="USER_LIMITS">
            <column name="USER_LIMITS_ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" primaryKeyName="USER_LIMITS_pkey"/>
            </column>
            <column name="USER_LIMITS_USER" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="USER_LIMIT" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-user-limits-user-unique-index" author="system">
        <createIndex tableName="USER_LIMITS" indexName="idx_user_limits_user" unique="true">
            <column name="USER_LIMITS_USER"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-user-limits-rollback-table" author="system">
        <createTable tableName="USER_LIMITS_ROLLBACK">
            <column name="USER_LIMITS_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="USER_LIMITS_ROLLBACK_pkey"/>
            </column>
            <column name="USER_LIMIT" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-add-foreign-key-to-rollback" author="system">
        <addForeignKeyConstraint
                baseTableName="USER_LIMITS_ROLLBACK"
                baseColumnNames="USER_LIMITS_ID"
                constraintName="fk_user_limits_rollback_id"
                referencedTableName="USER_LIMITS"
                referencedColumnNames="USER_LIMITS_ID"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="003-0" author="Vlad">
        <comment>Create client_product sequence</comment>
        <createSequence sequenceName="client_product_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="003-1" author="Vlad">
        <comment>Create client_products table</comment>
        <createTable tableName="client_products">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('client_product_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="balance" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="product_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_client_products_user_id"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="003-2" author="Vlad">
        <comment>Create index on user_id for client_products</comment>
        <createIndex tableName="client_products" indexName="idx_client_products_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-3" author="Vlad">
        <comment>Create index on account_number</comment>
        <createIndex tableName="client_products" indexName="idx_client_products_account_number">
            <column name="account_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-4" author="Vlad">
        <comment>Create index on product_type</comment>
        <createIndex tableName="client_products" indexName="idx_client_products_type">
            <column name="product_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>